{
  "name": "@nazarkalytiuk/rusc-xlsx",
  "version": "2.5.0",
  "description": "Fast Excel XLSX library for Node.js powered by rust_xlsxwriter",
  "type": "commonjs",
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "browser": "wrapper.browser.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazarKalytiuk/napi_rust_xlsxwrighter.git"
  },
  "napi": {
    "binaryName": "rusc_xlsx",
    "targets": [
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "universal-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "wasm32-wasip1"
    ],
    "darwin": {
      "universal": {
        "targets": [
          "x86_64-apple-darwin",
          "aarch64-apple-darwin"
        ]
      }
    },
    "wasm": {
      "threadlessInitialMemory": 1024,
      "cpu": false,
      "browser": {
        "buffer": true
      }
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:wasm": "napi build --platform --release --target wasm32-wasip1",
    "build:wrapper": "tsdown",
    "prepare": "tsdown",
    "benchmark": "node benchmarks/compare-generation.js",
    "benchmark:languages": "node benchmarks/compare-languages.js",
    "benchmark:runtimes": "node benchmarks/compare-runtimes.js",
    "benchmark:runtimes:exceljs": "node benchmarks/compare-runtimes.js --library exceljs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wasm": "vitest run --config vitest.wasm.config.mts",
    "test:browser": "vitest run --config vitest.browser.config.mts",
    "test:wasm-package": "node scripts/wasm-package-smoke.mts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "bash scripts/rust-coverage.sh",
    "lint": "oxlint --deny-warnings",
    "lint:rust": "cargo clippy --locked --all-targets -- -D warnings",
    "fmt": "oxfmt && cargo fmt --all",
    "fmt:check": "oxfmt --check && cargo fmt --all -- --check",
    "lint:package": "publint --strict && attw --pack .",
    "typecheck": "tsc --project tsconfig.json",
    "check": "npm run fmt:check && npm run lint && npm run lint:rust && npm run lint:package && npm run typecheck && npm run coverage:check",
    "universal": "napi universalize",
    "version": "napi version",
    "clean": "cargo clean && rm -rf *.node",
    "coverage:sync": "node scripts/coverage-checklist/cli.mts",
    "coverage:check": "node scripts/coverage-checklist/cli.mts --check"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "workbook",
    "rust",
    "napi-rs",
    "napi"
  ],
  "author": "Nazarii Kalytiuk <nazarkwork@gmail.com>",
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "browser.js",
    "wrapper.js",
    "wrapper.d.ts",
    "wrapper.browser.mjs",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3",
    "@napi-rs/cli": "^3.10.12",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "adm-zip": "^0.6.1",
    "buffer": "^6.0.3",
    "emnapi": "2.0.0-beta.3",
    "exceljs": "^4.4.0",
    "oxc-parser": "^0.158.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
