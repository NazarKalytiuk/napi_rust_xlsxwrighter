{
  "name": "@nazarkalytiuk/rusc-xlsx",
  "version": "2.0.0",
  "description": "Fast Excel XLSX library for Node.js powered by rust_xlsxwriter",
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazarKalytiuk/napi_rust_xlsxwrighter.git"
  },
  "napi": {
    "binaryName": "rusc_xlsx",
    "targets": [
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "universal-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ],
    "darwin": {
      "universal": {
        "targets": [
          "x86_64-apple-darwin",
          "aarch64-apple-darwin"
        ]
      }
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "benchmark": "node benchmarks/compare-generation.js",
    "benchmark:languages": "node benchmarks/compare-languages.js",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "jest",
    "typecheck": "tsc --project tsconfig.json",
    "universal": "napi universalize",
    "version": "napi version",
    "clean": "cargo clean && rm -rf *.node"
  },
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "workbook",
    "rust",
    "napi-rs",
    "napi"
  ],
  "author": "Nazarii Kalytiuk <nazarkwork@gmail.com>",
  "license": "MIT",
  "files": [
    "index.js",
    "index.d.ts",
    "wrapper.js",
    "wrapper.d.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2",
    "@types/node": "^24.13.3",
    "adm-zip": "^0.6.0",
    "jest": "^30.4.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
