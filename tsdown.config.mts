import { defineConfig, type UserConfig } from 'tsdown';

// Both builds keep wrapper.ts's comments out of the runtime files: the
// documentation ships in wrapper.d.ts.
const outputOptions: UserConfig['outputOptions'] = {
  generatedCode: { symbols: false },
  comments: { jsdoc: false },
};

export default defineConfig([
  {
    entry: 'wrapper.ts',
    // The package keeps its CommonJS shape (`main: wrapper.js`), so the output
    // lands next to the native loader instead of in a separate dist directory.
    outDir: '.',
    clean: false,
    format: 'cjs',
    fixedExtension: false,
    platform: 'node',
    dts: true,
    // Generated by napi-rs and loaded at runtime from the package root.
    deps: { neverBundle: ['./index.js'] },
    outputOptions,
    // CommonJS is deliberate: a dual ESM/CJS build would load two copies of every
    // class, breaking `instanceof` checks, and ESM callers can already import it.
    checks: { legacyCjs: false },
  },
  {
    // The browser entry (`browser` in package.json). Browsers never load
    // wrapper.js, so the two builds cannot meet in one program. It is ESM
    // because the WebAssembly loader behind ./browser.js uses top-level await.
    entry: { 'wrapper.browser': 'wrapper.ts' },
    outDir: '.',
    clean: false,
    format: 'esm',
    fixedExtension: true,
    platform: 'browser',
    // Browsers that support WebAssembly and top-level await (wrapper.ts is
    // ES2022: class fields).
    target: 'es2022',
    // Types come from wrapper.d.ts, which the first build emits.
    dts: false,
    plugins: [
      {
        name: 'rusc-xlsx:browser-binding',
        // ./browser.js is napi-rs's browser loader, the counterpart of
        // ./index.js: it re-exports the WebAssembly package's bindings.
        resolveId(source) {
          return source === './index.js' ? { id: './browser.js', external: true } : null;
        },
      },
    ],
    outputOptions,
  },
]);
